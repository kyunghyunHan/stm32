{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: build active F446 target",
      "type": "process",
      "command": "cargo",
      "args": [
        "f446",
        "--bin",
        "active-f446"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Rust: build F446",
      "type": "process",
      "command": "cargo",
      "args": [
        "f446"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Rust: build F767",
      "type": "process",
      "command": "cargo",
      "args": [
        "f767"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    }
  ]
}
